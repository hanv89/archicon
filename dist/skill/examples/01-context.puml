@startuml
' title:    Azure 3-tier web application — context
' type:     Context
' level:    1
' mode:     strict
' audience: Exec / sponsor / business
' question: Who or what touches this 3-tier web application, and what's outside our boundary?
' adr:      n/a
skinparam ranksep 28
skinparam nodesep 22
' Azure 3-tier web application — context view (no drill into internals)
'
' Source: https://github.com/hanv89/archicon
' License: MIT (this diagram); see repo LICENSE.
' Icons:   Microsoft Azure architecture icons (subject to Microsoft ToU
'          and Trademark Guidelines — see repo NOTICE).
'
' Render: paste this file's content into
'   https://www.plantuml.com/plantuml/uml/
' The PlantUML server fetches each <img:URL> at render time from this
' repository's public raw URLs.

title Azure 3-tier web application — context (Level 1)

' Actors
actor "End user" as user
actor "Admin"    as admin

' System of interest — a single box, no internal containers.
' Container drill-in lives in 03-system-architecture.puml.
package "Our System" {
  rectangle "3-tier Web App\n[Azure-hosted SaaS]" as system
}

' External systems we depend on
package "External" {
  rectangle "Microsoft Entra ID\n[OIDC auth]" as entra
  rectangle "Payment Gateway\n[Stripe API]"   as stripe
  rectangle "Email Provider\n[SendGrid]"      as email
}

user  -d-> system : "Browses + transacts"
admin -d-> system : "Manages content"
system -d-> entra  : "Authenticates users"
system -d-> stripe : "Charges card"
system -d-> email  : "Sends receipts"

@enduml
