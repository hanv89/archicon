#!/usr/bin/env bash
# Pre-push hook: refuse to push commits that leak internal tokens.
#
# git invokes this with `<remote-name> <remote-url>` as args and feeds
# one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# For each ref we hand the local ref + remote sha to check-leaks.sh in
# --pre-push mode, which scans:
#   - tracked-file content of the commits about to be pushed
#   - commit messages of those commits
#   - the branch name itself
# (the last two are where the historical leaks happened; the leak-check
# CI workflow only sees tracked-file content.)
#
# Enable once per clone:
#   git config core.hooksPath .githooks

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="${repo_root}/scripts/check-leaks.sh"

if [ ! -x "${checker}" ] && [ ! -f "${checker}" ]; then
  echo "pre-push: scripts/check-leaks.sh not found — skipping leak scan" >&2
  exit 0
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions (local_sha all-zero).
  if [ "${local_sha}" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if ! bash "${checker}" --pre-push "${local_ref}" "${remote_sha}"; then
    status=1
  fi
done

exit "${status}"
