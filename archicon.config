# archicon identity — single source of truth (shell-sourceable: KEY=value).
# Hard-coded per the project's identity decision (not parametrized). The build
# scripts and the CLI port read these so every repo/package/URL reference has
# one origin to change.

OWNER=hanv89
REPO=archicon
PACKAGE=@hanv89/arch-skill
RAW_BASE=https://raw.githubusercontent.com/hanv89/archicon
SKILL_NAME=architecture-diagram
SKILL_INSTALL_DIR=architecture-diagram
CANARY_ICON_PATH=dist/Azure/Compute/AzureVirtualMachine.png
