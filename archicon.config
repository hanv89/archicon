# archicon identity — single source of truth for the shell side
# (shell-sourceable: KEY=value). Hard-coded per the project's identity decision
# (not parametrized). The build scripts and contract gates source this file.
#
# The CLI does NOT read it — it compiles its own copies into
# packages/cli/src/adapters/_shared.ts. scripts/test_version_sync.sh asserts the
# two agree, so editing a value here without editing the constant there fails
# that gate instead of drifting silently.

OWNER=hanv89
REPO=archicon
PACKAGE=@hanv89/arch-skill
RAW_BASE=https://raw.githubusercontent.com/hanv89/archicon
SKILL_NAME=architecture-diagram
SKILL_INSTALL_DIR=architecture-diagram
SKILL_SRC_DIR=skills/architecture-diagram
SKILL_MANIFEST_PATH=dist/skill/manifest.json
CANARY_ICON_PATH=dist/Azure/Compute/AzureVirtualMachine.png
